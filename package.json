{
  "name": "sendify-dbschenker-mcp",
  "version": "1.0.0",
  "description": "MCP server for tracking DB Schenker/DSV shipments via the public tracking flow with structured shipment, package, and tracking event data.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "typescript",
    "nodejs",
    "zod",
    "logistics",
    "shipment-tracking",
    "db-schenker",
    "dsv",
    "api-integration",
    "web-integration",
    "vitest",
    "sendify",
    "code-challenge"
  ],
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "sendify-dbschenker-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT"
}
