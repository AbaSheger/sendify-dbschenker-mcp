# DB Schenker public tracking endpoint
# Discover this URL by opening the public tracking page in Chrome,
# opening DevTools -> Network tab, entering a reference number, and
# inspecting the XHR/fetch request that returns the shipment JSON.
# See README "Discovering the endpoint" section for the step-by-step.
SCHENKER_TRACKING_URL=

# Request timeout in milliseconds (optional, default 10000)
SCHENKER_TIMEOUT_MS=10000

# Number of retry attempts on transient failure (optional, default 2)
SCHENKER_MAX_RETRIES=2

# Set to 1 to enable verbose logging to stderr
DEBUG=0
